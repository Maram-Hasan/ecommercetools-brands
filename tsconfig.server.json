{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noUnusedLocals": true
  },
  "include": [
    "server",
    "shared",
    "tests",
    "vite.config.ts"
  ]
}
